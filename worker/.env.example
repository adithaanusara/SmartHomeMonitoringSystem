# Copy to .env and fill in. .env is gitignored.

# Realtime Database URL, copied from the Firebase console once the database exists.
# Looks like https://smarthomeapp-c60d9-default-rtdb.<region>.firebasedatabase.app
# or https://smarthomeapp-c60d9-default-rtdb.firebaseio.com for us-central1.
FIREBASE_DATABASE_URL=

# Must match the house key used by the app and the simulator.
HOUSE_ID=demo-house

# Path to the service-account key. Also gitignored — it grants full admin access.
SERVICE_ACCOUNT_PATH=./service-account.json
