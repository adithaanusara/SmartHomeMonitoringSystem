# Copy to .env and fill in. .env is gitignored.

# Realtime Database URL. Copy it from the console, do not construct it by hand — Firebase appends
# a numeric suffix to the instance name when the project id is already taken, so guessing gives a
# URL that 404s. It is also the `firebase_url` value inside app/google-services.json.
FIREBASE_DATABASE_URL=https://smarthomeapp-c60d9-77331-default-rtdb.asia-southeast1.firebasedatabase.app

# Must match the house key used by the app and the simulator.
HOUSE_ID=demo-house

# Path to the service-account key. Also gitignored — it grants full admin access.
SERVICE_ACCOUNT_PATH=./service-account.json
